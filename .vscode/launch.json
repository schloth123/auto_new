{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OneDrive-Dateien herunterladen",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/onedrive/src/download_onedrive_files.py",
            "console": "integratedTerminal",
            "args": [
                "--input",
                "${workspaceFolder}/onedrive/etc/one_drive_paths.yaml", // production
                // "${workspaceFolder}/onedrive/etc/one_drive_paths_simulation.yaml", // simulation
                "--target-dir",
                "${workspaceFolder}/onedrive/workspace/local_target_dir",
                "--output",
                "${workspaceFolder}/onedrive/workspace/target_paths.yaml"
            ]
        },
        {
            "name": "OneDrive-Sharelinks erstellen",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/onedrive/src/create_onedrive_share_links.py",
            "console": "integratedTerminal",
            "args": [
                "--folder",
                "${env:OneDrive}/Share/Belege_Förderungen/Bafa_Dach", // production
                // "${env:OneDrive}/Share/Schaeffler", // simulation
                "--permission",
                "view"
            ]
        },
        {
            "name": "YAML nach CSV konvertieren",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/onedrive/src/yaml_to_csv.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/onedrive/workspace/onedrive_share_paths.yaml"
            ]
        }
    ]
}