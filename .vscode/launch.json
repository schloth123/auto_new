{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OneDrive-Dateien herunterladen",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/onedrive/src/download_onedrive_files.py",
            "console": "integratedTerminal",
            "args": [
                "--input",
                // "${workspaceFolder}/onedrive/etc/one_drive_paths.yaml",
                "${workspaceFolder}/onedrive/etc/one_drive_paths_simulation.yaml",
                "--target-dir",
                "${workspaceFolder}/onedrive/workspace/local_target_dir",
                "--output",
                "${workspaceFolder}/onedrive/workspace/target_paths.yaml"
            ]
        },
        {
            "name": "OneDrive-Sharelinks erstellen",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/onedrive/src/create_onedrive_share_links.py",
            "console": "integratedTerminal",
            "args": [
                "--folder",
                "${env:OneDrive}/Share/Schaeffler",
                "--permission",
                "view"
            ]
        }
    ]
}